# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (MongoDB Community or Atlas URI)
# Default for local MongoDB: mongodb://127.0.0.1:27017/Imovies
MONGODB_URI=mongodb://127.0.0.1:27017/Imovies

# JWT Secret for Signing and Verifying User Tokens
JWT_SECRET=imovies_super_secure_production_secret_key_change_in_prod

# Client URL (for CORS validation if separated)
CLIENT_URL=http://localhost:3000

# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
